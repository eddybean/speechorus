# Supply-chain hardening (D-43). Needs npm 11.19+ (devEngines in package.json enforces it).

# Only resolve versions published at least 7 days ago: most malicious releases are found and
# unpublished within days. To take an urgent fix sooner, add the package to
# min-release-age-exclude for that one install, then remove it again.
min-release-age=7

# Install scripts run only for packages approved in package.json "allowScripts"
# (`npm approve-scripts <pkg>` after reviewing the script); any other one fails the install.
strict-allow-scripts=true

# No dependencies fetched from git: they bypass the registry and the release-age window.
allow-git=none

engine-strict=true

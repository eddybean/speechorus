{
  "name": "speechorus",
  "private": true,
  "version": "0.1.2",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "lint": "npm run typecheck && oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "deps:update": "npm update --save && cargo update --manifest-path src-tauri/Cargo.toml && node scripts/cargo-release-age.mjs --fix",
    "deps:check": "npm audit signatures && node scripts/cargo-release-age.mjs",
    "check": "npm run format:check && npm run format:rust:check && npm run lint && npm run lint:rust && npm test && npm run test:rust",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "immer": "^11.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,css,html}": "oxfmt --no-error-on-unmatched-pattern",
    "src-tauri/**/*.rs": "rustfmt --edition 2021 --config-path src-tauri/rustfmt.toml",
    "src-tauri/Cargo.lock": "node scripts/cargo-release-age.mjs"
  }
}
